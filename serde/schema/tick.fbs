// Схема тика для FlatBuffers — зеркало структур в rust/src/lib.rs (Tick)
// и go/tick.go. Слоты 0..7 задают порядок полей в vtable.
namespace serdebench;

table Tick {
  symbol: string (id: 0);
  venue: string (id: 1);
  price: ulong (id: 2);
  qty: ulong (id: 3);
  ts_ms: long (id: 4);
  side: string (id: 5);
  order_id: ulong (id: 6);
  flags: uint (id: 7);
}

root_type Tick;
